theory FreshOrderingTest
begin

builtins: hashing

rule Start:
    [ Fr(~s) ]
  --[ Start(~s) ]->
    [ Starting(~s) ]

rule Start2:
    [ Starting(s) ]
  --[ Start2(s) ]->
    [ State(s, h(s)) ]

rule Step:
    [ State(s, x) ]
  --[ Step(s) ]->
    [ State(s, h(x))]

// this is directly solvable with the original freshOrdering rule

end

