[	VSMW_3($S, psk, id_session_new, iv_suffix_new, %block_size, msalt, mkey)
	, Out(<$S, $R, iv_new, c>)
]

rule InitVolatileSecureMessageReader:
	let
		mkey_key2 = <'PSK_SKEY', $SenderKeyId, 'RTPS', $ProtocolVersion, $VendorId, $GuidPrefix_S>
		mkey_key = hmac(mkey_key2, psk)
		mkey = hmac(mkey_key, <'master_sender_key_derivation', %1>)

		msalt_key2 = <'PSK_SALT', $SenderKeyId, 'RTPS', $ProtocolVersion, $VendorId, $GuidPrefix_S>
		msalt_key = hmac(msalt_key2, psk)
		msalt = hmac(msalt_key, <'master_salt_derivation', %1>)

	in
[	!Participant($R, $SenderKeyId, $ProtocolVersion, $VendorId, $GuidPrefix_R)
	, !Participant($S, $SenderKeyId, $ProtocolVersion, $VendorId, $GuidPrefix_S)
	, !PSK(psk)
]
--[	
]->
[	!VSMR($R, $S, psk, msalt, mkey)
]

rule ReceiveVolatileSecureMessage:
	let
		iv = <id_session, iv_suffix>
		k_session = hmac( mkey, <'SessionKey', msalt, id_session>)

		c = senc(k_session, msg, iv, empty)
	in
[	!Participant($R, $SenderKeyId, $ProtocolVersion, $VendorId, $GuidPrefix_R)
	, !VSMR($R, $S, psk, msalt, mkey)
	//, In(<iv, c, t>)
	, In(<$S, $R, iv, c>) 
]
--[ //	OnlyOnce(<'receive', $R, $S, iv>)
	Commit($R, $S, msg)
	, Secure(psk)
	, Secret(msg)

]->
[ 	//VSMR($R, $S, msalt, mkey)
]

// *** Restrictions ***
//restriction Equality:
//"All x y #i. Eq(x, y) @i ==> x = y"

restriction OnlyOnce:
"All x #i #j. OnlyOnce(x) @i & OnlyOnce(x) @j ==> #i = #j"

restriction LessThanOrEqual:
"All x y #i. LessThanOrEqual(x, y) @i ==> not(y ⊏ x)"

// *** Executability lemma ***

end
