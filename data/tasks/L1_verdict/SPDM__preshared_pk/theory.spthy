    let
      new_own_master=hkdf(own_master_secret, version, 'binstr')
      new_enc_key= hkdf(new_own_master, version, 'key')
      outcipher= senc(<'Encap_Key_Update', version, 'VerifyNewKey'>, new_enc_key)
    
