      , OwnKeyUpdateR(~tid, ~sid, bindSid, ~oidI, ~oidR, own_master_secret, new_own_master)
      , Keys(~tid, ~sid, ~kuid, bindSid, new_own_master, partner_master_secret, 'Resp')
      , RKEyUpdateVerif(~sid, ~tid, ~kuid)
      , OnlyOnceResp(~tid, ~sid)
       ]->
    [ !AppDataKey(~newkuid, ~tid, ~sid, ~oidI, ~oidR, bindSid, version, new_own_master, partner_master_secret, new_enc_key, dec_key, 'Resp')
    , Out(outcipher)
     ]

