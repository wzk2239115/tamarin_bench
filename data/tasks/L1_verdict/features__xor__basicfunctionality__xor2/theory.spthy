theory xor2
begin

builtins: xor

//  ⊕ or XOR

rule testsend:
  [ Fr(~x), Fr(~y), Fr(~z)]
--[ OnlyOnce()
  , Secret(~x) ]->
  [ Out(<~x XOR ~y, ~y XOR ~z, ~z>)]

restriction unique:
  "All #i #j. OnlyOnce() @i & OnlyOnce() @j ==> #i = #j"

// this secrecy lemma should be broken!
