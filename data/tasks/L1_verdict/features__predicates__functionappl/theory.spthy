theory minimal_predicates begin

builtins: multiset

predicates: Smaller(x,y) <=> Ex z. x + z = y
          , Equal(x,y)   <=> x = y
          , Added(x,y)   <=> Ex #a. A(x,y)@a & #a < #NOW

rule A:
  [In(x), In(y)] --[ _restrict(Smaller(x,y)), A(x,y), B('1','1'+'1')]-> [ X('A')]

rule B:
    [In(x), In(y)] --[ _restrict(Added(x,y))]-> []

rule C:
    [In(<x,x>)] --[ _restrict(Equal(x,x)), C() ]-> []

end

