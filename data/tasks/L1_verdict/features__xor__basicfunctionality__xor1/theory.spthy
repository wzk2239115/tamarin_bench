theory xor1
begin

builtins: xor

//  ⊕ or XOR for exclusive-or

rule testsend:
  [ Fr(~x), Fr(~y)]
--[ OnlyOnce()
  , Secret(~x) ]->
  [ Out(<~x XOR ~y, ~y>)]

restriction unique:
  "All #i #j. OnlyOnce() @i & OnlyOnce() @j ==> #i = #j"

// this secrecy lemma should be broken!
// FINDS ATTACK AUTOMATICALLY (2017-03-22)

end
