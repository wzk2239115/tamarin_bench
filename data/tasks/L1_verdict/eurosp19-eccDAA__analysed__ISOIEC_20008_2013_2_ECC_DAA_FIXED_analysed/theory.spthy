       W     = multp(x.104,
                     multp(PRF(x.108, x.109, x.110), multp(x.107, multp(x.105, x.106))))
       h     = H4(H3(multp(x.112, multp(x.113, x.114)),
                     multp(x.112, multp(x.115, multp(x.113, x.114))),
                     multp(x.112,
