        tsk   = tsk.45
        tsk1  = PRF(x.53, x.54, x.55)
        z     = accept
        z.1   = calcR1(minus(multp(s(randS1.44, tsk.45), J.32),
                             multp(h.39, multp(PRF(x.53, x.54, x.55), J.32))))
        z.2   = calcR2(minus(multp(s(randS1.44, tsk.45),
                                   multp(x.56, multp(x.59, multp(x.57, x.58)))),
