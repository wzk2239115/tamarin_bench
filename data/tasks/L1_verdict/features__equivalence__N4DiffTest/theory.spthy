theory N4DiffTest
begin

/*
 * Protocol:	 Test whether condition N4 is treated correctly
 * Modeler: 	 Jannik Dreier and Ralf Sasse
 * Described in: 
 * Date: 	 April 2015
 *
 * Status: 	 working
 */

builtins: diffie-hellman

// Registering a public key
rule Test:
  [ Fr(~f), In(x) ]
  --[ Prod(x) ]->
  [ Out(diff(x,~f)) ]

restriction Product:
  "
  All x #i. Prod(x) @ i ==> (Ex a b. x = (a*b))
  "

  
end
