    [ L_State_C4(tid,C,S, prev_res_psk,prev_messages,prev_nc,prev_ns,prev_g,prev_sg,prev_hrr,prev_x,prev_y,prev_gx,prev_gy,prev_gxy,prev_psk_ke_mode,prev_psk_id,prev_edi,prev_es,prev_hs,prev_ms,prev_cats,prev_sats,prev_hs_keyc,prev_hs_keys,prev_auth_status,prev_ems,prev_rms,prev_cert_req ),
      SendStream(tid, C, S, prev_auth_status, prev_app_keyc)
    ]
  --[ C4_update_req(tid),
      Instance(tid, C, 'client'),
      RPostHS(tid, C, 'client', <hs,rms,S,auth_status,messages>)
