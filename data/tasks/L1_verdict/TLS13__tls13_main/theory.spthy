let
    prev_rms = Expand(ms, <'rms', <h(messages)>>, '32')
    
res_psk = prev_res_psk
nc = prev_nc
ns = prev_ns
g = prev_g
sg = prev_sg
x = prev_x
y = prev_y
gx = prev_gx
gy = prev_gy
gxy = prev_gxy
